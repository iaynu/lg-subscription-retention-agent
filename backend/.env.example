# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 절대 깃허브에 올리지 마세요)
# PostgreSQL:  postgresql://postgres:비밀번호@localhost:5432/churn
# 비워 두면 파일 DB(sqlite)로 바로 시작합니다.
DATABASE_URL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# auto = 키가 있으면 OpenAI, 없으면 템플릿 / template = LLM 안 씀
LLM_MODE=auto

# Rule Engine 수치 (팀 확정 전 가정값)
COOLDOWN_DAYS=30
COST_CAP=50000
MAX_ACTIONS=3
MAX_CUSTOMER_MSGS=2
TYPE_SHARE_MIN=0.20
MIN_RISK=MID
