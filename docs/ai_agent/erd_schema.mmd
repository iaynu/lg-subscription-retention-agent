    customer {
        varchar customer_id PK
        varchar age_group
        varchar region_sido
        date joined_at
        char ad_consent_yn
    }
    subscription {
        varchar subscription_id PK
        varchar customer_id FK
        varchar product_category FK
        date start_date
        date end_date
        numeric monthly_fee
        varchar care_type
        varchar status
    }
    product_profile {
        varchar product_category PK
        smallint visit_interval_months
        numeric subscriber_weight
    }
    care_manager {
        varchar manager_id PK
        varchar region_sido
    }
    usage_thinq {
        bigint usage_id PK
        varchar subscription_id FK
        date week_start_date
        smallint run_count
        smallint app_login_days
    }
    care_visit {
        bigint visit_id PK
        varchar subscription_id FK
        varchar visit_type
        varchar visit_status
        smallint satisfaction_score
    }
    voc_contact {
        bigint voc_id PK
        varchar subscription_id FK
        date contact_date
        varchar category
        char resolved_yn
    }
    payment {
        bigint payment_id PK
        varchar subscription_id FK
        date billing_month
        varchar payment_status
    }
    notice_log {
        bigint notice_id PK
        varchar subscription_id FK
        varchar notice_type
        timestamp opened_at
    }
    churn_prediction {
        bigint prediction_id PK
        varchar subscription_id FK
        numeric churn_probability
        varchar risk_level
        numeric risk_rank_pct
    }
    churn_prediction_type {
        bigint prediction_id PK
        smallint type_rank PK
        varchar type_id FK
        numeric contribution_share
    }
    churn_type {
        varchar type_id PK
        varchar type_name
    }
    solution_catalog {
        varchar solution_id PK
        varchar type_id FK
        varchar solution_category
        varchar channel
        char ad_yn
        char agent_selectable_yn
        numeric offer_cost
        varchar fee_impact
        smallint priority
        text eligibility
        varchar customer_title
        varchar message_items
    }
    action_log {
        bigint action_id PK
        varchar action_batch_id FK
        varchar subscription_id FK
        bigint prediction_id FK
        varchar type_id FK
        varchar solution_id FK
        varchar channel
        varchar message_source
        varchar action_status
        varchar decision_note
        timestamp created_at
    }
    synth_churn_label {
        varchar subscription_id PK
        smallint churn_30d
    }
    synth_truth_type {
        varchar subscription_id PK, FK
        varchar type_id PK, FK
        numeric activation_strength
    }
    agent_result {
        varchar request_id PK
        varchar subscription_id FK
        bigint prediction_id FK
        varchar mode
        varchar outcome
        varchar prompt_version
        jsonb result_json
    }
    survey_send {
        bigint survey_id PK
        varchar subscription_id FK
        varchar action_batch_id FK
        varchar survey_type
        char responded_yn
    }
    survey_response {
        bigint response_id PK
        bigint survey_id FK
        char completed_yn
    }
    survey_answer {
        bigint answer_id PK
        bigint response_id FK
        varchar question_id
        varchar answer_code
    }
    ai_proposal {
        bigint proposal_id PK
        varchar proposal_kind
        varchar related_type_id FK
        varchar status
    }
    synth_truth_topic {
        varchar subscription_id PK
        varchar topic_id PK
        numeric strength
    }
